# Multi-stage Dockerfile para el Dashboard Streamlit
FROM python:3.12-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir streamlit plotly pandas openpyxl sqlalchemy psycopg2-binary gspread

COPY . .

EXPOSE 8501

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

ENTRYPOINT ["streamlit", "run", "src/reporting/dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
