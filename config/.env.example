# Configuración de Entorno - Template (NO INGRESAR SECRETOS REALES AQUÍ)

# Clave maestra de cifrado AES-256-GCM (mínimo 32 caracteres / recomendado 64 hex)
MASTER_ENCRYPTION_KEY=replace_with_32_byte_hex_key_here
JWT_SECRET_KEY=replace_with_another_64_char_hex_key_here

# Lista blanca de IPs autorizadas para el host (en VPS colocar tu IP pública fija, ej. 109.205.178.33)
SERVER_IP_WHITELIST=127.0.0.1,0.0.0.0

# Base de datos PostgreSQL (en Docker Compose usar host `postgres`)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=p2p_bot
DATABASE_URL=postgresql+psycopg2://postgres:replace_with_strong_postgres_password@postgres:5432/p2p_bot

# Redis para colas y eventos (en Docker Compose usar host `redis`)
REDIS_URL=redis://redis:6379/0

# Dominio / Proxy inverso Caddy & Cloudflare
# Sin dominio aún: dejar `:80` | Con dominio en Cloudflare: `app.tudominio.com`
APP_SITE_ADDRESS=:80
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Binance P2P API (Credenciales se almacenan cifradas en DB por usuario)
BINANCE_API_KEY_IDENTIFIER=p2p_merchant_key_1
USE_SANDBOX=true

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=12345678
TELEGRAM_TRADER_USERS=6326947793

# IA Gemini / OCR (opcional, separadas por coma)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL_NAME=gemini-flash-lite-latest

# Entorno de ejecución (development | production)
ENVIRONMENT=development
LOG_LEVEL=INFO
