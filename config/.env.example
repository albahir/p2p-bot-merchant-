# Configuración de Entorno - Template (NO INGRESAR SECRETOS REALES AQUÍ)

# Clave maestra de cifrado AES-256-GCM (32 bytes en formato hex o base64)
MASTER_ENCRYPTION_KEY=replace_with_32_byte_hex_key_here

# Lista blanca de IPs autorizadas para el host (separadas por comas)
SERVER_IP_WHITELIST=127.0.0.1,0.0.0.0

# Base de datos PostgreSQL / TimescaleDB
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/p2p_bot

# Redis para colas y eventos
REDIS_URL=redis://localhost:6379/0

# Binance P2P API (Credenciales se almacenan cifradas en DB, estos son identificadores iniciales de carga)
BINANCE_API_KEY_IDENTIFIER=p2p_merchant_key_1

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=12345678,87654321

# Entorno de ejecución
ENVIRONMENT=development
LOG_LEVEL=INFO
